config {
  type: "view",
  schema: "invented_software_staging",
  description: "Operating costs separated into expense flows and balance stock (cash_balance_eom)"
}

-- TRAP 3 AVOIDED:
-- cash_balance_eom is a stock balance, not an operating expense!
SELECT
  cost_id,
  year_month,
  TRIM(cost_category) AS cost_category,
  -- Convert cents to EUR
  ROUND(amount_eur / 100.0, 2) AS amount_eur,
  TRIM(description) AS description,
  -- Flag to distinguish true cost flows from balance stock
  CASE
    WHEN TRIM(cost_category) = "cash_balance_eom" THEN FALSE
    ELSE TRUE
  END AS is_cost_flow
FROM
  ${ref("raw_operating_costs")}
